# -------------------------------------------------
# Node / npm / Yarn
# -------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pnpm-lock.yaml
package-lock.json
yarn.lock
pnpm-lock.yaml

# -------------------------------------------------
# Front‑end (Next.js) build artefacts
# -------------------------------------------------
# Next.js
.next/
out/                # static export output (Netlify)
.next/cache/
.next/trace/

# Build / dist folders (if you use `npm run build` with custom output)
dist/
build/

# Static assets generated by the build
public/static/

# Environment files
.env
.env.*               # any .env.* (e.g., .env.local, .env.production)

# VS Code / IDE settings
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# -------------------------------------------------
# Backend (Express) build artefacts
# -------------------------------------------------
# TypeScript compiled output
backend/dist/
backend/build/

# SQLite DB – keep the source DB but ignore any local copies the scraper may generate
backend/data/*.sqlite3    # keep the schema file if you track it, otherwise ignore all
# If you want to keep the DB in version control, remove this line.

# Backend env files
backend/.env
backend/.env.*

# Logs
backend/*.log
backend/logs/
logs/

# -------------------------------------------------
# Scripts / temporary files
# -------------------------------------------------
scripts/*.log
temp/
tmp/

# -------------------------------------------------
# Docker
# -------------------------------------------------
docker-compose.override.yml
docker-compose.yml    # keep if you version‑control the compose file, otherwise ignore
Dockerfile            # keep (usually versioned)
*.dockerignore

# -------------------------------------------------
# OS / editor / misc
# -------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# -------------------------------------------------
# Coverage / test artefacts
# -------------------------------------------------
coverage/
*.lcov

# -------------------------------------------------
# Generated documentation / site
# -------------------------------------------------
docs/site/
*.html
*.pdf

# -------------------------------------------------
# Misc
# -------------------------------------------------
*.tgz
*.log
.sass-cache/
.cache/