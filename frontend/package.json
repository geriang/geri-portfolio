{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint . --ext .js,.ts",
    "test": "jest",
    "export": "next export",
    "verify-lazy": "npm run build && node scripts/verifyLazy.js",
    "lighthouse": "npm run dev & npx wait-on http://localhost:3000 && npx lighthouse http://localhost:3000 --quiet --chrome-flags=\\\"--headless\\\" --output=json --output-path=lhreport.json && node -e \"const fs=require('fs'); const report=JSON.parse(fs.readFileSync('lhreport.json','utf8')); if(report.categories.performance.score<0.8){process.exit(1);} else {process.exit(0);}\",
    "test-dev": "npm run dev & SERVER_PID=$!; sleep 2; curl -s http://localhost:3000 && kill $SERVER_PID",
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "next": "14.2.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.6.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lighthouse": "^13.6.0",
    "wait-on": "^7.2.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.15",
    "typescript": "^5"
  }
}
