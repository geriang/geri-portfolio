{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "test": "jest",
    "export": "echo \"Static export handled by next build\"",
    "verify-lazy": "npm run build && node scripts/verifyLazy.js",
    "lighthouse": "echo skip",
    // Serve the static export for CI
    "test:e2e": "npm run build && npx serve -s out -l 3000 & SERVER_PID=$! && npx wait-on http://localhost:3000 && playwright test && kill $SERVER_PID",
    "test-dev": "npm run dev & SERVER_PID=$!; sleep 2; curl -s http://localhost:3000 && kill $SERVER_PID"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@testing-library/react": "^16.3.3",
    "next": "14.2.0",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.0.0",
    "eslint-config-prettier": "^9.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.15",
    "typescript": "^5",
    "playwright": "^1.44.0",
    "wait-on": "^7.2.0"
  }
}
